<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- R=49.5 (1): Anillo mayor (Borde exterior) -->
    <path android:strokeColor="#6B45E6" android:strokeWidth="0.6" android:pathData="M 50,50 m -49.5,0 a 49.5,49.5 0 1,1 99,0 a 49.5,49.5 0 1,1 -99,0" />
    <!-- R=41.7 (2): Anillo menor -->
    <path android:strokeColor="#221247" android:strokeWidth="0.4" android:pathData="M 50,50 m -41.7,0 a 41.7,41.7 0 1,1 83.4,0 a 41.7,41.7 0 1,1 -83.4,0" />
    <!-- R=33.3 (3): Anillo mayor -->
    <path android:strokeColor="#6B45E6" android:strokeWidth="0.6" android:pathData="M 50,50 m -33.3,0 a 33.3,33.3 0 1,1 66.6,0 a 33.3,33.3 0 1,1 -66.6,0" />
    <!-- R=25 (4): Anillo menor -->
    <path android:strokeColor="#221247" android:strokeWidth="0.4" android:pathData="M 50,50 m -25,0 a 25,25 0 1,1 50,0 a 25,25 0 1,1 -50,0" />
    <!-- R=16.7 (5): Anillo mayor -->
    <path android:strokeColor="#6B45E6" android:strokeWidth="0.6" android:pathData="M 50,50 m -16.7,0 a 16.7,16.7 0 1,1 33.4,0 a 16.7,16.7 0 1,1 -33.4,0" />
    <!-- R=8.3 (6): Anillo menor -->
    <path android:strokeColor="#221247" android:strokeWidth="0.4" android:pathData="M 50,50 m -8.3,0 a 8.3,8.3 0 1,1 16.6,0 a 8.3,8.3 0 1,1 -16.6,0" />
    <!-- Centro relleno (Degradado Suave) -->
    <path android:pathData="M 50,50 m -16.7,0 a 16.7,16.7 0 1,1 33.4,0 a 16.7,16.7 0 1,1 -33.4,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="50"
                android:centerY="50"
                android:gradientRadius="16.7">
                <item android:offset="0.0" android:color="#665D3FD3"/>
                <item android:offset="0.6" android:color="#225D3FD3"/>
                <item android:offset="1.0" android:color="#005D3FD3"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
