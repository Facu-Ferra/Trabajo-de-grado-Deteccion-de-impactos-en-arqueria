<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- R=50 (1): Anillo mayor (Borde exterior) -->
    <path android:strokeColor="#6B45E6" android:strokeWidth="0.6" android:pathData="M 50,50 m -49.5,0 a 49.5,49.5 0 1,1 99,0 a 49.5,49.5 0 1,1 -99,0" />
    <!-- R=45 (2): Anillo menor -->
    <path android:strokeColor="#221247" android:strokeWidth="0.4" android:pathData="M 50,50 m -45,0 a 45,45 0 1,1 90,0 a 45,45 0 1,1 -90,0" />
    <!-- R=40 (3): Anillo mayor -->
    <path android:strokeColor="#6B45E6" android:strokeWidth="0.6" android:pathData="M 50,50 m -40,0 a 40,40 0 1,1 80,0 a 40,40 0 1,1 -80,0" />
    <!-- R=35 (4): Anillo menor -->
    <path android:strokeColor="#221247" android:strokeWidth="0.4" android:pathData="M 50,50 m -35,0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" />
    <!-- R=30 (5): Anillo mayor -->
    <path android:strokeColor="#6B45E6" android:strokeWidth="0.6" android:pathData="M 50,50 m -30,0 a 30,30 0 1,1 60,0 a 30,30 0 1,1 -60,0" />
    <!-- R=25 (6): Anillo menor -->
    <path android:strokeColor="#221247" android:strokeWidth="0.4" android:pathData="M 50,50 m -25,0 a 25,25 0 1,1 50,0 a 25,25 0 1,1 -50,0" />
    <!-- R=20 (7): Anillo mayor -->
    <path android:strokeColor="#6B45E6" android:strokeWidth="0.6" android:pathData="M 50,50 m -20,0 a 20,20 0 1,1 40,0 a 20,20 0 1,1 -40,0" />
    <!-- R=15 (8): Anillo menor -->
    <path android:strokeColor="#221247" android:strokeWidth="0.4" android:pathData="M 50,50 m -15,0 a 15,15 0 1,1 30,0 a 15,15 0 1,1 -30,0" />
    <!-- R=10 (9): Anillo mayor -->
    <path android:strokeColor="#6B45E6" android:strokeWidth="0.6" android:pathData="M 50,50 m -10,0 a 10,10 0 1,1 20,0 a 10,10 0 1,1 -20,0" />
    
    <!-- Centro relleno (Degradado Suave) -->
    <path android:pathData="M 50,50 m -15,0 a 15,15 0 1,1 30,0 a 15,15 0 1,1 -30,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="50"
                android:centerY="50"
                android:gradientRadius="15">
                <item android:offset="0.0" android:color="#665D3FD3"/>
                <item android:offset="0.6" android:color="#225D3FD3"/>
                <item android:offset="1.0" android:color="#005D3FD3"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
